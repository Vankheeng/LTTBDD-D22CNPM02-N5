<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText android:id="@+id/etMaPhong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã phòng (VD: P01)"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText android:id="@+id/etTenPhong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên phòng"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText android:id="@+id/etGiaThue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá thuê (đ/tháng)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tình trạng phòng:"
            android:textSize="14sp"
            android:textColor="#757575"/>

        <RadioGroup android:id="@+id/rgTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton android:id="@+id/rbConTrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn trống"
                android:checked="true"/>

            <RadioButton android:id="@+id/rbDaThue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã thuê"
                android:layout_marginStart="24dp"/>
        </RadioGroup>

        <LinearLayout android:id="@+id/layoutNguoiThue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText android:id="@+id/etTenNguoiThue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên người thuê"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp"/>

            <EditText android:id="@+id/etSoDienThoai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>

        <!-- Hai nút Hủy và Lưu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnHuy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HỦY"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#9E9E9E"
                android:textColor="@android:color/white"/>

            <Button android:id="@+id/btnLuu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LƯU"
                android:backgroundTint="#1976D2"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>